{
  "name": "escape-the-backrooms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/data/generate-image-dimensions.js && node scripts/data/generate-localized-routes.js && node scripts/data/generate-next-routes.js",
    "dev": "next dev",
    "prebuild": "node scripts/data/generate-image-dimensions.js && node scripts/data/generate-localized-routes.js && node scripts/data/generate-next-routes.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --experimental-cli src/ scripts/ docs/",
    "generate-sitemap": "node scripts/data/generate-sitemap.js",
    "generate:image-dimensions": "node scripts/data/generate-image-dimensions.js",
    "validate:data": "node scripts/audit/validate-data.js",
    "validate:structure": "node scripts/audit/validate-structure.js",
    "audit:pages": "node scripts/audit/validate-pages.js",
    "check": "npm run lint && npm run typecheck && npm run validate:structure && npm run validate:data && npm run build"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "3.7.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2"
  }
}
